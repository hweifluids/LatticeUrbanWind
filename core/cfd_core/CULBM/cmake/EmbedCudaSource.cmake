cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED INPUT_FILE OR INPUT_FILE STREQUAL "")
    message(FATAL_ERROR "EmbedCudaSource.cmake requires INPUT_FILE")
endif()
if(NOT DEFINED OUTPUT_FILE OR OUTPUT_FILE STREQUAL "")
    message(FATAL_ERROR "EmbedCudaSource.cmake requires OUTPUT_FILE")
endif()
if(NOT EXISTS "${INPUT_FILE}")
    message(FATAL_ERROR "CUDA source fragment does not exist: ${INPUT_FILE}")
endif()

file(READ "${INPUT_FILE}" cuda_source)
string(REPLACE "\r\n" "\n" cuda_source "${cuda_source}")
string(REPLACE "\r" "\n" cuda_source "${cuda_source}")

# A raw-string delimiter may contain at most 16 characters.  Keep it stable so
# generated output is deterministic and reject the only sequence that could
# terminate one of the generated literals early.
set(raw_delimiter "CULBM_CUDA")
string(FIND "${cuda_source}" ")${raw_delimiter}\"" delimiter_collision)
if(NOT delimiter_collision EQUAL -1)
    message(FATAL_ERROR
        "CUDA source contains the reserved raw-string delimiter: "
        ")${raw_delimiter}\"")
endif()

get_filename_component(output_directory "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
set(temporary_file "${OUTPUT_FILE}.tmp")
file(WRITE "${temporary_file}"
    "// Generated from ${INPUT_FILE}. Do not edit this file.\n")

# Stay below conservative host-compiler string-literal limits.  Splitting a
# raw string does not alter the bytes appended to the std::string at runtime.
set(chunk_size 12000)
string(LENGTH "${cuda_source}" source_length)
set(offset 0)
while(offset LESS source_length)
    math(EXPR remaining "${source_length} - ${offset}")
    if(remaining GREATER chunk_size)
        string(SUBSTRING "${cuda_source}" ${offset} ${chunk_size} candidate)
        string(FIND "${candidate}" "\n" final_newline REVERSE)
        if(final_newline EQUAL -1)
            message(FATAL_ERROR
                "CUDA source contains a line longer than ${chunk_size} bytes: "
                "${INPUT_FILE}")
        endif()
        math(EXPR current_size "${final_newline} + 1")
    else()
        set(current_size ${remaining})
    endif()
    string(SUBSTRING "${cuda_source}" ${offset} ${current_size} chunk)
    file(APPEND "${temporary_file}"
        "source += R\"${raw_delimiter}(${chunk})${raw_delimiter}\";\n")
    math(EXPR offset "${offset} + ${current_size}")
endwhile()

execute_process(
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${temporary_file}" "${OUTPUT_FILE}"
    RESULT_VARIABLE copy_result)
file(REMOVE "${temporary_file}")
if(NOT copy_result EQUAL 0)
    message(FATAL_ERROR "Failed to update generated CUDA source: ${OUTPUT_FILE}")
endif()
